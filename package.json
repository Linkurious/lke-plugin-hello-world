{
  "name": "lke-plugin-hello-world",
  "version": "1.0.0",
  "description": "A boilerplate of how to start Linkurious plugin development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linkurious/lke-plugin-hello-world.git"
  },
  "author": "Linkurious SAS",
  "license": "ISC",
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "files": [
    "packages/backend/dist",
    "packages/frontend/assets",
    "packages/frontend/dist",
    "packages/frontend/index.html",
    "manifest.json"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "build": "npm run build --workspaces",
    "postbuild": "npm pack && mv ${npm_package_name}-${npm_package_version}.tgz ${npm_package_name}-${npm_package_version}.lke"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
